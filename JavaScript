function calcularSafra() {
    // 1. Captura os valores digitados pelo usuário
    const area = parseFloat(document.getElementById('area').value);
    const produtividade = parseFloat(document.getElementById('produtividade').value);
    const precoSaca = parseFloat(document.getElementById('precoSaca').value);
    const custoTotal = parseFloat(document.getElementById('custoTotal').value);

    // 2. Validação simples para não processar campos vazios ou negativos
    if (isNaN(area) || isNaN(produtividade) || isNaN(precoSaca) || isNaN(custoTotal) || 
        area <= 0 || produtividade <= 0 || precoSaca <= 0 || custoTotal < 0) {
        alert("Por favor, preencha todos os campos com valores válidos maiores que zero.");
        return;
    }

    // 3. Lógica Matemática do Agro
    const totalSacas = area * produtividade;
    const faturamentoBruto = totalSacas * precoSaca;
    const lucroLiquido = faturamentoBruto - custoTotal;

    // 4. Manipulação do DOM para exibir os resultados na tela
    const containerResultado = document.getElementById('resultadoSafra');
    
    containerResultado.innerHTML = `
        <h3>📊 Relatório Estimado:</h3>
        <p>Produção Total: <strong>${totalSacas.toFixed(0)} sacas</strong></p>
        <p>Faturamento Bruto: <strong>R$ ${faturamentoBruto.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</strong></p>
        <p>Lucro Líquido: <strong style="color: ${lucroLiquido >= 0 ? '#1b5e20' : '#b71c1c'}">
            R$ ${lucroLiquido.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
        </strong></p>
    `;

    // Mostra o bloco de resultado removendo classes de ocultação se houver
    containerResultado.style.display = "block";
}

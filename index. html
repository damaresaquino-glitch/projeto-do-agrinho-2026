<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgroTech-Calcula</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>🌾 AgroTech-Calcula</h1>
        <p>Planejamento inteligente para o homem do campo</p>
    </header>

    <main class="container">
        <section class="card">
            <h2>💰 Estimativa de Safra</h2>
            <p>Calcule a previsão de faturamento e lucro da sua lavoura.</p>
            
            <div class="input-group">
                <label for="area">Área Plantada (Hectares):</label>
                <input type="number" id="area" placeholder="Ex: 50" min="0">
            </div>

            <div class="input-group">
                <label for="produtividade">Produtividade Média (Sacas por Hectare):</label>
                <input type="number" id="produtividade" placeholder="Ex: 60" min="0">
            </div>

            <div class="input-group">
                <label for="precoSaca">Preço Atual da Saca (R$):</label>
                <input type="number" id="precoSaca" placeholder="Ex: 120" min="0">
            </div>

            <div class="input-group">
                <label for="custoTotal">Custo de Produção Total (R$):</label>
                <input type="number" id="custoTotal" placeholder="Ex: 15000" min="0">
            </div>

            <button onclick="calcularSafra()">Calcular Resultados</button>

            <div id="resultadoSafra" class="resultado escondido">
                </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 AgroTech-Calcula - Projeto Escolar Web</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
